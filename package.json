{
  "name": "elden-ring-personal-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate && npm run db:setup",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:setup": "prisma db push && tsx scripts/constraints.ts && tsx scripts/seed.ts",
    "db:seed": "tsx scripts/seed.ts",
    "data:collect": "tsx scripts/collect.ts",
    "data:validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "better-sqlite3": "12.11.1"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^6.19.3",
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "undici": "^7.30.0"
  }
}
